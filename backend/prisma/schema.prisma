// Prisma schema — QA Control Center
// URL configurada no prisma.config.ts via DATABASE_URL
// Migrations em: prisma/migrations/
// Queries usam pg (pool) diretamente; Prisma gerencia apenas o schema/migrations.

generator client {
  provider = "prisma-client"
  output   = "../prisma"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// PROJETOS (test cases)
// =============================================================================
model Projeto {
  id         Int      @id @default(autoincrement())
  titulo     String
  descricao  String?
  feature    String?
  cenarios   Json?
  created_by Int?
  creator    User?    @relation("ProjetoCreator", fields: [created_by], references: [id], onDelete: SetNull)
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?

  test_suites       TestSuite[]
  test_suite_cases  TestSuiteCase[]
  execution_results ExecutionResult[]

  @@map("projetos")
}

// =============================================================================
// TEST SUITES
// =============================================================================
model TestSuite {
  id         Int      @id @default(autoincrement())
  nome       String
  descricao  String?  @default("")
  projeto_id Int?
  projeto    Projeto? @relation(fields: [projeto_id], references: [id], onDelete: Cascade)
  created_by Int?
  creator    User?    @relation("TestSuiteCreator", fields: [created_by], references: [id], onDelete: SetNull)
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?

  execucoes        Execucao[]
  test_suite_cases TestSuiteCase[]
  test_plan_suites TestPlanSuite[]

  @@map("test_suites")
}

// =============================================================================
// REQUIREMENTS
// =============================================================================
model Requirement {
  id         Int      @id @default(autoincrement())
  titulo     String
  descricao  String?  @default("")
  status     String   @default("Open")
  prioridade String   @default("Medium")
  created_by Int?
  creator    User?    @relation("RequirementCreator", fields: [created_by], references: [id], onDelete: SetNull)
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?

  @@map("requirements")
}

// =============================================================================
// TEST PLANS
// =============================================================================
model TestPlan {
  id         Int      @id @default(autoincrement())
  titulo     String
  descricao  String?  @default("")
  escopo     String?  @default("")
  objetivo   String?  @default("")
  ambiente   String?  @default("")
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?

  test_plan_suites TestPlanSuite[]

  @@map("test_plans")
}

// =============================================================================
// EXECUÇÕES
// =============================================================================
model Execucao {
  id         Int       @id @default(autoincrement())
  suite_id   Int?
  suite      TestSuite? @relation(fields: [suite_id], references: [id], onDelete: Cascade)
  ambiente   String    @default("staging")
  status     String    @default("pending")
  resultado  String?
  finalized  Boolean   @default(false)
  created_by Int?
  creator    User?     @relation("ExecucaoCreator", fields: [created_by], references: [id], onDelete: SetNull)
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?

  execution_results ExecutionResult[]

  @@map("execucoes")
}

// =============================================================================
// RELACIONAMENTOS
// =============================================================================
model TestSuiteCase {
  id         Int       @id @default(autoincrement())
  suite_id   Int
  suite      TestSuite @relation(fields: [suite_id], references: [id], onDelete: Cascade)
  projeto_id Int
  projeto    Projeto   @relation(fields: [projeto_id], references: [id], onDelete: Cascade)
  created_at DateTime  @default(now())

  @@unique([suite_id, projeto_id])
  @@map("test_suite_cases")
}

model TestPlanSuite {
  id         Int      @id @default(autoincrement())
  plan_id    Int
  plan       TestPlan @relation(fields: [plan_id], references: [id], onDelete: Cascade)
  suite_id   Int
  suite      TestSuite @relation(fields: [suite_id], references: [id], onDelete: Cascade)
  created_at DateTime @default(now())

  @@unique([plan_id, suite_id])
  @@map("test_plan_suites")
}

model ExecutionResult {
  id          Int      @id @default(autoincrement())
  execucao_id Int
  execucao    Execucao @relation(fields: [execucao_id], references: [id], onDelete: Cascade)
  projeto_id  Int
  projeto     Projeto  @relation(fields: [projeto_id], references: [id], onDelete: Cascade)
  status      String   @default("pending")
  comentario  String?
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now())

  @@unique([execucao_id, projeto_id])
  @@map("execution_results")
}

// =============================================================================
// USUÁRIOS
// =============================================================================
model User {
  id            Int      @id @default(autoincrement())
  name          String
  email         String   @unique
  password_hash String
  role          String   @default("qa")
  created_at    DateTime @default(now()) @db.Timestamptz

  password_reset_tokens PasswordResetToken[]
  projetos_criados      Projeto[]     @relation("ProjetoCreator")
  suites_criadas        TestSuite[]   @relation("TestSuiteCreator")
  requirements_criados  Requirement[] @relation("RequirementCreator")
  execucoes_criadas     Execucao[]    @relation("ExecucaoCreator")
  audit_logs            AuditLog[]    @relation("AuditUser")

  @@map("users")
}

// =============================================================================
// TOKENS DE RESET DE SENHA
// =============================================================================
model PasswordResetToken {
  id         Int       @id @default(autoincrement())
  user_id    Int
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  token_hash String
  expires_at DateTime  @db.Timestamptz
  used_at    DateTime? @db.Timestamptz
  created_at DateTime  @default(now()) @db.Timestamptz

  @@map("password_reset_tokens")
}

// =============================================================================
// TOKENS REVOGADOS (logout seguro)
// Armazena JTIs de tokens invalidados até expirarem naturalmente.
// =============================================================================
model RevokedToken {
  id         Int      @id @default(autoincrement())
  jti        String   @unique
  expires_at DateTime @db.Timestamptz
  created_at DateTime @default(now()) @db.Timestamptz

  @@index([expires_at])
  @@map("revoked_tokens")
}

// =============================================================================
// AUDIT LOG (Fase 3, Item 9)
// Registra toda ação de escrita (CREATE / UPDATE / DELETE) nas entidades principais.
// =============================================================================
model AuditLog {
  id          Int       @id @default(autoincrement())
  user_id     Int?
  user        User?     @relation("AuditUser", fields: [user_id], references: [id], onDelete: SetNull)
  entity_type String    @db.VarChar(50)
  entity_id   Int?
  action      String    @db.VarChar(20)
  old_values  Json?
  new_values  Json?
  ip_address  String?   @db.VarChar(45)
  created_at  DateTime  @default(now()) @db.Timestamptz

  @@index([entity_type, entity_id])
  @@index([user_id])
  @@index([created_at])
  @@map("audit_logs")
}
