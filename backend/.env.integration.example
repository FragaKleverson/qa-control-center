# Copy outside version control, e.g. .env.integration.local. Never reuse existing credentials.
NODE_ENV=test
QA_INTEGRATION_MODE=disposable
DB_HOST=127.0.0.1
DB_PORT=5435
DB_DATABASE=qa_control_integration
DB_USER=qa_integration_runner
DB_PASSWORD=
# Use the same URL-encoded credentials and the exact destination above.
DATABASE_URL=
# Record pg_control_system().system_identifier from the newly provisioned container.
QA_INTEGRATION_CLUSTER_ID=
# Authorization flags MUST be supplied by the operator process, never saved here.
